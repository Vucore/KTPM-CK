# Supabase Dashboard > Connect > Session pooler (5432). Use an encoded DB password.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Optional separate runtime role DSNs
# CATALOG_DATABASE_URL=
# BOOKING_DATABASE_URL=
# PAYMENT_DATABASE_URL=
INTERNAL_API_KEY=
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
CATALOG_URL=http://127.0.0.1:8001
PAYMENT_URL=http://127.0.0.1:8002
HOLD_SECONDS=300
